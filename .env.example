# Terraform Copilot Agent - Environment Configuration Example
# Copy this file to .env for local configuration (never commit .env to version control)

# Workspace Root Directory (Absolute path to safe execution sandbox)
# TERRAFORM_WORKSPACE_DIR=/path/to/isolated/workspace

# LLM Provider Configuration (Used in subsequent milestones)
# LLM_PROVIDER=mock
# OPENAI_API_KEY=your-openai-api-key-placeholder
# ANTHROPIC_API_KEY=your-anthropic-api-key-placeholder

# Execution Limits
# EXECUTION_TIMEOUT_SECONDS=30
# MAX_CORRECTION_ITERATIONS=3

# Logging Level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
